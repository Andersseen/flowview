{
  "name": "flowview",
  "scopeName": "source.flowview",
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-script" },
    { "include": "#raw-style" },
    { "include": "#escape" },
    { "include": "#raw-interpolation" },
    { "include": "#interpolation" },
    { "include": "#control-keyword" },
    { "include": "#control-expression" },
    { "include": "#binding" },
    { "include": "#context-name" },
    { "include": "#block" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "raw-script": {
      "name": "meta.embedded.block.javascript.flowview",
      "begin": "(<)(script)\\b([^>]*)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" }
      },
      "end": "(</)(script)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.js",
      "patterns": [{ "include": "source.js" }]
    },
    "raw-style": {
      "name": "meta.embedded.block.css.flowview",
      "begin": "(<)(style)\\b([^>]*)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" }
      },
      "end": "(</)(style)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.css",
      "patterns": [{ "include": "source.css" }]
    },
    "binding": {
      "patterns": [
        {
          "name": "meta.binding.boolean.flowview",
          "match": "(\\[)(disabled|hidden|checked|selected|required|readonly|multiple|open)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.binding.begin.flowview" },
            "2": { "name": "entity.other.attribute-name.flowview" },
            "3": { "name": "punctuation.definition.binding.end.flowview" }
          }
        },
        {
          "name": "meta.binding.attribute.flowview",
          "match": "(\\[)(attr|class)\\.([\\w-]+)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.binding.begin.flowview" },
            "2": { "name": "keyword.other.binding.flowview" },
            "3": { "name": "entity.other.attribute-name.flowview" },
            "4": { "name": "punctuation.definition.binding.end.flowview" }
          }
        },
        {
          "name": "meta.binding.event.flowview",
          "match": "(\\()([\\w:-]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.binding.begin.flowview" },
            "2": { "name": "keyword.operator.event.flowview" },
            "3": { "name": "punctuation.definition.binding.end.flowview" }
          }
        }
      ]
    },
    "context-name": {
      "match": "\\bcontext\\b",
      "name": "variable.language.context.flowview"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.html.flowview",
          "begin": "<!--",
          "end": "-->"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.flowview",
          "match": "\\\\\\{\\{\\{"
        },
        {
          "name": "constant.character.escape.flowview",
          "match": "\\\\[@{}\\\\]"
        }
      ]
    },
    "raw-interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.flowview meta.interpolation.raw.flowview",
          "begin": "\\{\\{\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.flowview" }
          },
          "end": "\\}\\}\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.flowview" }
          },
          "patterns": [
            { "include": "#context-name" },
            { "include": "source.js" }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.flowview",
          "begin": "\\{\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.flowview" }
          },
          "end": "\\}\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.flowview" }
          },
          "patterns": [
            { "include": "#context-name" },
            { "include": "source.js" }
          ]
        }
      ]
    },
    "control-keyword": {
      "patterns": [
        {
          "match": "(@)(else if)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(if)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(else)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(for)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(empty)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(switch)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(case)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        },
        {
          "match": "(@)(default)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.flowview" },
            "2": { "name": "keyword.control.flowview" }
          }
        }
      ]
    },
    "control-expression": {
      "name": "meta.control.expression.flowview",
      "begin": "(?<=@(if|else if|for|switch|case)\\b)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "2": { "name": "punctuation.section.parens.begin.flowview" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.flowview" }
      },
      "patterns": [
        { "include": "#nested-parens" },
        { "include": "#control-operator" },
        { "include": "#context-name" },
        { "include": "source.js" }
      ]
    },
    "nested-parens": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.flowview" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.flowview" }
      },
      "patterns": [{ "include": "#nested-parens" }, { "include": "source.js" }]
    },
    "control-operator": {
      "match": "\\b(of|track)\\b",
      "name": "keyword.operator.word.flowview"
    },
    "block": {
      "name": "meta.block.flowview",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.block.begin.flowview" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.flowview" }
      },
      "patterns": [{ "include": "$self" }]
    }
  }
}
