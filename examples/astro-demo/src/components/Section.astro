---
export interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  alt?: boolean;
}

const { id, title, eyebrow, alt = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class:list={["section", alt && "section-alt"]}
>
  <div class="page-frame grid gap-8">
    <header class="grid gap-2">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2
        id={`${id}-heading`}
        class="text-2xl font-black tracking-normal text-foreground md:text-3xl"
      >
        {title}
      </h2>
      <div class="lede"><slot name="intro" /></div>
    </header>
    <slot />
  </div>
</section>
