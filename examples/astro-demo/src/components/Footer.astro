---
import { footerContext } from "../data/footer";
import type { FooterContext } from "../data/types";

export interface Props {
  context?: FooterContext;
}

const { context = footerContext } = Astro.props;
---

<template flowview={context} is:raw>
  <footer class="border-t border-border bg-card">
    <div class="page-frame grid gap-10 py-12 md:grid-cols-[1.4fr_2fr]">
      <div class="grid content-start gap-2">
        <p class="text-lg font-black text-foreground">{{ context.brand }}</p>
        <p class="max-w-sm text-sm text-muted-foreground">{{ context.tagline }}</p>
      </div>
      <nav aria-label="Footer" class="grid gap-8 sm:grid-cols-3">
        @for (column of context.columns; track column.title) {
          <div class="grid content-start gap-3">
            <h2 class="eyebrow">{{ column.title }}</h2>
            <ul class="grid list-none gap-2 p-0 text-sm">
              @for (link of column.links; track link.label) {
                <li>
                  @if (link.external) {
                    <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground hover:underline">
                      {{ link.label }}
                    </a>
                  } @else {
                    <a href="{{ link.href }}" class="font-medium text-foreground hover:underline">
                      {{ link.label }}
                    </a>
                  }
                </li>
              }
            </ul>
          </div>
        }
      </nav>
    </div>
    <div class="border-t border-border">
      <p class="page-frame py-5 text-xs text-muted-foreground">{{ context.note }}</p>
    </div>
  </footer>
</template>
