<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>FlowView native forms acceptance</title>
  </head>
  <body>
    <h1>Native forms and explicit replacement</h1>
    <p>
      Editing stays browser-local until the form is submitted or the host
      commits state.
    </p>
    <div id="forms-root"></div>
    <section>
      <h2>Immediate signal binding (replacement on every edit)</h2>
      <div id="bound-root"></div>
      <output id="bound-result"></output>
    </section>
    <p>Events:</p>
    <pre id="event-log"></pre>
    <p>Submit result: <output id="submit-result"></output></p>
    <p>Replacement result: <output id="replacement-result"></output></p>

    <script>
      import { createView } from "@flowview/dom";
      import { signal } from "@flowview/reactive";
      import { render } from "../../views/forms.flow";
      import "virtual:flowview-events/src/views/forms.flow.ts";

      const initial = {
        name: "Ada",
        notes: "First note\nSecond note",
        enabled: true,
        nameRequired: true,
        locked: true,
        plan: "pro",
        region: "south",
        topics: ["blue"],
        detailsOpen: true,
      };
      let model = { ...initial };
      const view = createView("#forms-root", render);
      view.render(model);

      const boundRoot = document.querySelector("#bound-root");
      if (!boundRoot) throw new Error("Missing bound forms demo root");
      const boundSource = signal({ ...initial });
      const boundView = createView(boundRoot, render);
      boundView.bind(boundSource);
      boundRoot.addEventListener("input", (event) => {
        if (
          !(event.target instanceof HTMLInputElement) ||
          event.target.name !== "name"
        )
          return;
        const oldInput = event.target;
        const wasFocused = document.activeElement === oldInput;
        boundSource.update((value) => ({ ...value, name: oldInput.value }));
        const currentInput = boundView.ref<HTMLInputElement>("name");
        const result = document.querySelector("#bound-result");
        if (result && currentInput) {
          result.textContent = JSON.stringify({
            oldDetached: !oldInput.isConnected,
            replaced: oldInput !== currentInput,
            wasFocused,
            focusOnNewNode: document.activeElement === currentInput,
            renderedValue: currentInput.value,
          });
        }
      });

      document.addEventListener("flowview:form-commit", (event) => {
        const values = (
          event as CustomEvent<Record<string, FormDataEntryValue>>
        ).detail;
        const oldInput = view.ref<HTMLInputElement>("name");
        const wasFocused = document.activeElement === oldInput;
        const selectionStartBefore = oldInput?.selectionStart;
        model = {
          ...model,
          name: String(values.name ?? ""),
          notes: String(values.notes ?? ""),
          enabled: "enabled" in values,
          plan: String(values.plan ?? "basic"),
          region: String(values.region ?? "north"),
          topics: Array.from(
            new FormData(
              document.querySelector<HTMLFormElement>("#forms-root form")!,
            ).getAll("topics"),
            String,
          ),
        };
        view.update(model);
        const currentInput = view.ref<HTMLInputElement>("name");
        const result = document.querySelector("#replacement-result");
        if (result && oldInput && currentInput) {
          result.textContent = JSON.stringify({
            oldDetached: !oldInput.isConnected,
            replaced: oldInput !== currentInput,
            wasFocused,
            focusOnNewNode: document.activeElement === currentInput,
            selectionStartBefore,
            selectionStartAfter: currentInput.selectionStart,
            renderedValue: currentInput.value,
          });
        }
      });

      window.addEventListener(
        "pagehide",
        () => {
          view.dispose();
          boundView.dispose();
        },
        { once: true },
      );
    </script>
  </body>
</html>
