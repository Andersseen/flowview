---
import CodeBlock from "../components/CodeBlock.astro";
import Layout from "../layouts/Layout.astro";
import { pageTitle } from "../data";
import * as code from "../data/snippets";
import authoringExample from "../snippets/events-author.astro.txt?raw";
import compiledExample from "../snippets/events-compiled.html.txt?raw";
---

<Layout
  title={pageTitle("Events")}
  description="FlowView Events compiles native browser event bindings into delegated listeners for Astro and Vite, including form, focus and composition events."
>
  <div class="page-frame grid gap-12 py-12 md:py-14">
    <header class="grid gap-4">
      <p class="eyebrow">FlowView Events</p>
      <h1
        class="max-w-4xl text-4xl font-black tracking-normal text-foreground md:text-5xl"
      >
        Native events in your template, no listener boilerplate
      </h1>
      <p class="lede">
        Events is a separate, optional compiler. Write <code class="inline-code"
          >(event)="handler()"</code
        > next to the markup, declare handlers in one
        <code class="inline-code">&lt;script data-flowview&gt;</code> block, and FlowView
        wires up delegated native listeners. It works in Astro (<code
          class="inline-code">@flowview/astro-events</code
        >) and plain Vite projects such as Hono (<code class="inline-code"
          >@flowview/vite-events</code
        >).
      </p>
    </header>

    <section
      id="live"
      aria-labelledby="live-heading"
      class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]"
    >
      <div class="panel grid content-start gap-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="live-heading" class="text-lg font-extrabold text-foreground">
            Live, from this page
          </h2>
          <span class="chip chip-ok">Compiled by FlowView Events</span>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="button" (click)="save($event)" class="btn btn-primary"
            >Save</button
          >
          <button
            type="button"
            (click)="removeItem('item-1', $el)"
            class="btn disabled:opacity-60">Remove item 1</button
          >
        </div>

        <label
          class="grid gap-2 text-sm font-bold text-foreground"
          for="event-demo-input"
        >
          <span>(input) event</span>
          <input
            id="event-demo-input"
            (input)="previewInput($event)"
            placeholder="Type to trigger (input)"
            class="w-full rounded-md border border-border bg-background px-3 py-2 font-semibold text-foreground placeholder:text-muted-foreground"
          />
        </label>

        <label
          class="grid gap-2 text-sm font-bold text-foreground"
          for="event-demo-select"
        >
          <span>(change) event</span>
          <select
            id="event-demo-select"
            (change)="pickPlan($event)"
            class="w-full rounded-md border border-border bg-background px-3 py-2 font-semibold text-foreground"
          >
            <option value="free">Free</option>
            <option value="team">Team</option>
          </select>
        </label>

        <form
          id="event-demo-form"
          (submit)="submitForm($event)"
          class="flex flex-wrap gap-3"
        >
          <input
            name="email"
            aria-label="Email"
            placeholder="you@example.com"
            class="min-w-0 flex-1 rounded-md border border-border bg-background px-3 py-2 font-semibold text-foreground placeholder:text-muted-foreground"
          />
          <button class="btn">Submit</button>
        </form>

        <p
          id="event-output"
          class="min-h-14 rounded-md border border-border bg-background p-4 text-sm font-bold text-muted-foreground"
          aria-live="polite"
        >
          Click an action to see the compiled event handlers run.
        </p>

        <script data-flowview>
          function save(event) {
            const output = document.querySelector("#event-output");
            const button = event.currentTarget;
            if (button instanceof HTMLElement) {
              button.textContent = "Saved";
            }
            if (output) {
              output.textContent = `Saved from a ${event.type} event`;
            }
          }

          function removeItem(id, element) {
            const output = document.querySelector("#event-output");
            if (element instanceof HTMLElement) {
              element.setAttribute("disabled", "true");
              element.textContent = "Removed";
            }
            if (output) {
              output.textContent = `Removed ${id} with a serialized argument`;
            }
          }

          function previewInput(event) {
            const output = document.querySelector("#event-output");
            const target = event.target;
            if (output && target && "value" in target) {
              output.textContent = `Input event value: ${String(target.value)}`;
            }
          }

          function pickPlan(event) {
            const output = document.querySelector("#event-output");
            if (output) {
              output.textContent = `Change event value: ${String(event.target.value)}`;
            }
          }

          function submitForm(event) {
            event.preventDefault();
            const output = document.querySelector("#event-output");
            if (output) {
              output.textContent = "Submit event handled without a page load";
            }
          }
        </script>
      </div>

      <div class="grid content-start gap-4">
        <CodeBlock
          code={authoringExample}
          lang="astro"
          label="What you write"
        />
        <CodeBlock
          code={compiledExample}
          lang="html + js"
          label="What the build emits"
        />
      </div>
    </section>

    <section id="syntax" aria-labelledby="syntax-heading" class="grid gap-5">
      <h2 id="syntax-heading" class="text-2xl font-bold text-foreground">
        What a handler can receive
      </h2>
      <div class="grid gap-6 lg:grid-cols-2">
        <dl class="grid content-start gap-4 text-sm">
          <div>
            <dt class="font-bold text-foreground">
              <code class="inline-code">$event</code>
            </dt>
            <dd class="text-muted-foreground">The native browser event.</dd>
          </div>
          <div>
            <dt class="font-bold text-foreground">
              <code class="inline-code">$el</code>
            </dt>
            <dd class="text-muted-foreground">
              The element the binding is on.
            </dd>
          </div>
          <div>
            <dt class="font-bold text-foreground">Literal arguments</dt>
            <dd class="text-muted-foreground">
              Strings, numbers and booleans, such as <code class="inline-code"
                >remove('item-1')</code
              >, serialized into the markup.
            </dd>
          </div>
          <div>
            <dt class="font-bold text-foreground">
              Template-scope property paths
            </dt>
            <dd class="text-muted-foreground">
              Values such as <code class="inline-code">item.id</code> inside an <code
                class="inline-code">@for</code
              > loop are read at render time.
            </dd>
          </div>
          <div>
            <dt class="font-bold text-foreground">Build-time validation</dt>
            <dd class="text-muted-foreground">
              Every binding must resolve to a function declared in the file's
              single script block.
            </dd>
          </div>
        </dl>
        <CodeBlock
          code={code.eventsTemplate}
          lang="html"
          label="Supported forms"
        />
      </div>
    </section>

    <section
      id="native-forms"
      aria-labelledby="native-forms-heading"
      class="grid gap-3"
    >
      <h2 id="native-forms-heading" class="text-2xl font-bold text-foreground">
        Native forms and explicit replacement
      </h2>
      <p class="prose-width text-muted-foreground">
        Events passes native <code class="inline-code">input</code>,
        <code class="inline-code">change</code>,
        <code class="inline-code">submit</code>, keyboard, focus/blur,
        composition and details toggle events to the handler. The handler owns
        <code class="inline-code">preventDefault()</code> and any state commit. Boolean
        bindings such as <code class="inline-code">[checked]</code>
        serialize HTML attributes; they do not track later live control properties.
        An explicit <code class="inline-code">view.update()</code>
        replaces controls and does not promise to preserve dirty values, focus, selection
        or IME composition. See the form examples and tested limits in the repository
        README.
      </p>
    </section>

    <section
      id="delegation"
      aria-labelledby="delegation-heading"
      class="grid gap-3"
    >
      <h2 id="delegation-heading" class="text-2xl font-bold text-foreground">
        Delegated listeners and dynamic DOM
      </h2>
      <p class="prose-width text-muted-foreground">
        The runtime attaches one listener per event type to the document and
        finds the handler when the event fires. Elements added later, such as a
        re-rendered <code class="inline-code">@for</code> list or a view replaced
        by <code class="inline-code">@flowview/dom</code>, work with no
        rebinding.
        <a class="font-bold text-primary" href="/client-dom#dynamic"
          >See it on the client DOM page →</a
        >
      </p>
    </section>

    <section id="scopes" aria-labelledby="scopes-heading" class="grid gap-3">
      <h2 id="scopes-heading" class="text-2xl font-bold text-foreground">
        Scopes and navigation
      </h2>
      <p class="prose-width text-muted-foreground">
        Each template file gets its own handler scope, so two components can
        both declare <code class="inline-code">save()</code> without colliding. In
        Astro, handlers keep working across View Transitions navigation. Both behaviors
        are asserted in the browser suite listed on
        <a class="font-bold text-primary" href="/capabilities"
          >the capabilities page</a
        >.
      </p>
    </section>

    <section
      id="architecture"
      aria-labelledby="architecture-heading"
      class="grid gap-3"
    >
      <h2 id="architecture-heading" class="text-2xl font-bold text-foreground">
        Events and the HTML compiler are separate
      </h2>
      <p class="prose-width text-muted-foreground">
        The Events compiler runs first and rewrites <code class="inline-code"
          >(click)</code
        > into <code class="inline-code">data-flow-on-click</code> attributes. The
        Rust HTML compiler never parses event syntax, which keeps the core small and
        means FlowView templates remain usable without any browser code at all.
      </p>
      <p class="prose-width text-sm text-muted-foreground">
        Install: <code class="inline-code">@flowview/astro-events</code> for Astro,
        <code class="inline-code">@flowview/vite-events</code> for Vite, both on top
        of
        <code class="inline-code">@flowview/events</code>. <a
          class="font-bold text-primary"
          href="/getting-started">Setup steps →</a
        >
      </p>
    </section>
  </div>
</Layout>
