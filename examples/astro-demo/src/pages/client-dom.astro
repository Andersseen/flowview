---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
  title={`${site.title} client DOM`}
  description="A tiny client-side Flowview DOM runtime demo."
>
  <main class="mx-auto grid w-full max-w-5xl gap-8 px-4 py-12 sm:px-6 lg:px-8">
    <header class="grid gap-3">
      <p
        class="text-sm font-medium uppercase tracking-wide text-muted-foreground"
      >
        @flowview/dom
      </p>
      <h1 class="text-3xl font-semibold text-foreground md:text-4xl">
        Minimal client-side DOM views
      </h1>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground">
        A compiled .flow template renders an empty target, receives client data,
        and updates the same native DOM element without app-level template
        strings.
      </p>
    </header>

    <div
      id="client-items"
      class="rounded-md border border-border bg-card p-5 shadow-sm"
      data-testid="client-items"
    >
    </div>
  </main>

  <script>
    import { createView } from "@flowview/dom";
    import { effect } from "@flowview/reactive";
    import { render } from "../views/client-items.flow";
    import { clientState } from "@/state/client-state";
    import "virtual:flowview-events/src/views/client-items.flow.ts";

    const view = createView("#client-items", render);

    // The application owns `clientState`; this is the one explicit boundary
    // where its value reaches the compiled DOM view.
    effect(() => {
      view.update(clientState());
    });

    setTimeout(() => {
      clientState.update((state) => ({
        ...state,
        items: [
          { id: 1, name: "Draft report", status: "active" },
          { id: 2, name: "Review dashboard", status: "completed" },
        ],
      }));
    }, 100);
  </script>
</Layout>
