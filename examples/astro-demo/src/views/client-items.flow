<section aria-labelledby="client-items-title">
  <h2 id="client-items-title">Client DOM view</h2>

  <p data-testid="summary" data-flow-ref="summary">
    {{ context.items.length }} task{{ context.items.length === 1 ? "" : "s" }}
  </p>

  <button
    type="button"
    data-testid="reload"
    (click)="reload()"
    [disabled]="context.loading"
    [class.loading]="context.loading"
  >
    @if (context.loading) {
      Loading...
    } @else {
      Reload
    }
  </button>

  <button type="button" data-testid="clear" (click)="clearItems()">
    Clear
  </button>

  <ul
    data-testid="client-items-list"
    data-flow-ref="list"
    [attr.aria-busy]="context.loading"
    [class.loading]="context.loading"
  >
    @for (item of context.items; track item.id) {
      <li data-testid="client-item" data-flow-ref="item" [class.active]="context.selectedTaskId === item.id">
        <strong>{{ item.name }}</strong>

        @if (item.status === "completed") {
          <span data-testid="client-item-status">Completed</span>
        } @else {
          <span data-testid="client-item-status">Active</span>
        }

        <button type="button" (click)="selectTask(item.id)">
          Select
        </button>
      </li>
    } @empty {
      <li data-testid="client-empty">No tasks yet.</li>
    }
  </ul>

  @if (context.selectedTaskId !== null) {
    <p data-testid="selected-task" data-flow-ref="selected-task">Selected task {{ context.selectedTaskId }}</p>
  } @else {
    <p data-testid="selected-task" data-flow-ref="selected-task">No task selected</p>
  }
</section>

<script data-flowview>
  import { clearItems as emptyItems, reloadItems, selectTask as setSelectedTask } from "@/state/client-state";

  function reload() {
    reloadItems();
  }

  function clearItems() {
    emptyItems();
  }

  function selectTask(id) {
    setSelectedTask(id);
  }
</script>
